# StageComms Configuration

# Server Settings
HOST=0.0.0.0
PORT=8000
DEBUG=false

# Database
DATABASE_URL=sqlite:////app/database/stagecomms.db

# File Paths
UPLOAD_DIR=/app/uploads
LOGS_DIR=/app/logs

# Logging
LOG_LEVEL=INFO

# Optional: Admin password (leave empty for no password)
# ADMIN_PASSWORD=your_password_here

# WebSocket
WS_HEARTBEAT_INTERVAL=30
WS_TIMEOUT=60
